# Live mode. Without a key, Release Desk runs offline with a scripted stand-in model.
ANTHROPIC_API_KEY=
# Any Anthropic model name Continuum accepts.
RELEASE_DESK_MODEL=claude-sonnet-5-5
# Seconds a release proposal waits for a reviewer before it is refused.
RELEASE_DESK_APPROVAL_TIMEOUT=900
# Force offline mode even when a key is set.
RELEASE_DESK_OFFLINE=
